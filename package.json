{
  "name": "jts-hud",
  "version": "8.1.1",
  "description": "A simple counter-strike hud management application built with Electron and Vite.",
  "main": "./out/main/index.js",
  "author": "John Timmermann",
  "homepage": "https://github.com/auuruum/JTs-Hud",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "test": "npm run typecheck && npm run test:auto-director && npm run test:challonge",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:win:portable": "node scripts/build-windows-portable.mjs",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "test:e2e": "electron-vite build && playwright test",
    "test:e2e:ui": "electron-vite build && playwright test --ui",
    "test:e2e:headed": "electron-vite build && playwright test --headed",
    "test:e2e:smoke": "electron-vite build && playwright test e2e/app.spec.ts",
    "test:auto-director": "esbuild scripts/test-auto-director.ts scripts/test-auto-director-settings.ts scripts/test-camera-transports.ts scripts/test-auto-director-geometry.ts scripts/test-auto-director-aerial.ts scripts/test-auto-director-ml.ts scripts/test-camera-debug.ts --bundle --platform=node --format=cjs --outdir=out/tests && node out/tests/test-auto-director.js && node out/tests/test-auto-director-settings.js && node out/tests/test-camera-transports.js && node out/tests/test-auto-director-geometry.js && node out/tests/test-auto-director-aerial.js && node out/tests/test-auto-director-ml.js && node --test out/tests/test-camera-debug.js",
    "test:challonge": "tsc --target ES2022 --module commonjs --esModuleInterop --skipLibCheck --outDir out/tests/challonge scripts/test-challonge.ts && node out/tests/challonge/scripts/test-challonge.js",
    "demo:extract": "python3 scripts/extract-auto-director-demo.py",
    "demo:evaluate": "esbuild scripts/evaluate-auto-director-demo.ts --bundle --platform=node --format=cjs --outfile=out/tests/evaluate-auto-director-demo.js && node out/tests/evaluate-auto-director-demo.js",
    "geometry:evaluate": "esbuild scripts/evaluate-auto-director-geometry.ts --bundle --platform=node --format=cjs --outfile=out/tests/evaluate-auto-director-geometry.js && node out/tests/evaluate-auto-director-geometry.js",
    "ml:dataset": "esbuild scripts/export-auto-director-training-data.ts --bundle --platform=node --format=cjs --outfile=out/tests/export-auto-director-training-data.js && node out/tests/export-auto-director-training-data.js",
    "aerial:app": "electron tools/aerial-capture/app/main.cjs",
    "build:aerial:win:portable": "electron-builder --config tools/aerial-capture/electron-builder.yml --win portable",
    "aerial:capture": "esbuild tools/aerial-capture/src/index.ts --bundle --platform=node --format=cjs --outfile=out/tools/aerial-capture.js && node out/tools/aerial-capture.js",
    "test:aerial-capture": "esbuild scripts/test-aerial-capture.ts --bundle --platform=node --format=cjs --outfile=out/tests/test-aerial-capture.js && node --test out/tests/test-aerial-capture.js scripts/test-aerial-capture-app.cjs"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "adm-zip": "^0.5.16",
    "cors": "^2.8.6",
    "csgogsi": "^4.0.2",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.0",
    "multer": "^2.0.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sqlite3": "^5.1.7",
    "vue-router": "^4.6.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "^4.2.0",
    "@playwright/test": "^1.58.2",
    "@types/adm-zip": "^0.5.7",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.19.1",
    "@types/sqlite3": "^3.1.11",
    "@vitejs/plugin-vue": "^6.0.2",
    "electron": "^39.8.10",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "prettier": "^3.7.4",
    "supabase": "^2.76.14",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vue": "^3.5.25",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.1.6"
  }
}
